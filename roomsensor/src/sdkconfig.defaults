# This config is ignored
# Run idf.py set-target esp32s2
# CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Enable RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# ESP-IDF v5.3: Enable coredump to flash (ELF format) with boot check
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=n
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=n

# Enable bootloader/app rollback support to allow PENDING_VERIFY images to rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# ESP-ADF: its headers still use the pre-v10 FreeRTOS type names
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# ESP-ADF: use the new I2C driver (roomsensor uses it; mixing in the legacy driver aborts at boot)
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# WiFi/IP event handlers run on the system event task; 2304 bytes overflows on a disconnect
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# Only allocations up to 4 KB go to internal RAM by default; larger ones use PSRAM.
# At 16 KB, internal RAM ran out after audio started and later tasks failed to start.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Put WiFi/lwIP buffers and mbedTLS (HTTPS OTA) allocations in PSRAM to leave internal RAM for tasks and DMA
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
