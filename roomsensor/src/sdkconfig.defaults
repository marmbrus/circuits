# This config is ignored
# Run idf.py set-target esp32s2
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Enable RAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# ESP-IDF v5.3: Enable coredump to flash (ELF format) with boot check
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=n
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=n

# Enable bootloader/app rollback support to allow PENDING_VERIFY images to rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# ESP-ADF: its headers still use the pre-v10 FreeRTOS type names
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# ESP-ADF: use the new I2C driver (roomsensor uses it; mixing in the legacy driver aborts at boot)
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Trust Let's Encrypt's Gen Y roots too, so OTA from updates.acgt.net doesn't depend on its chain
# keeping the cross-signs to ISRG Root X1/X2 (see certs/letsencrypt_gen_y_roots.pem)
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/letsencrypt_gen_y_roots.pem"

# TLS (MQTT over mqtts://, OTA) takes its buffers from PSRAM: internal RAM is too short for them
# alongside Wi-Fi and audio DMA, which then fail to allocate (I2S aborts)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# and so do Wi-Fi's and lwIP's, leaving internal RAM for task stacks (OTA's) and DMA
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Bluetooth LE: NimBLE, used only to scan for devices such as Tile trackers (components/ble).
# Wi-Fi and Bluetooth share the radio through software coexistence.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_EXT_ADV=n
# Scanning is the only Bluetooth activity, and each one allowed costs controller RAM
CONFIG_BT_CTRL_BLE_MAX_ACT=1
# Keep NimBLE's host allocations out of internal RAM
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# FreeRTOS task stats, for the console's `tasks` command (each task's stack high-water mark)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Task stacks, from the `tasks` high-water marks. The system event task (Wi-Fi and IP event
# handlers) had under 300 bytes to spare. The main task's stack is freed once startup finishes
# (app_main returns), so a little more room for startup costs nothing after it.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
# lwIP's TCP/IP task ("tiT") came within 536 bytes of its 3 KB under TLS and mic streaming
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
# ESP-IDF's IPC tasks (one per core) had 192 bytes of their 1280 left in a DEBUG-level build
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# No ANSI colours in log lines: fewer bytes on the console, and none in the logs netlog publishes
CONFIG_LOG_COLORS=n
